HOST=localhost
PORT=8000
API_PREFIX=/api
LOG_LEVEL=info
LOG_PRETTY=true
TRUST_PROXY=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
SUBMISSIONS_RATE_LIMIT_WINDOW_MS=60000
SUBMISSIONS_RATE_LIMIT_MAX=240
CORS_ORIGINS=*
CLASSIFIER_API_BASE=
START_CLASSIFIER_API=false
CLASSIFIER_API_HOST=127.0.0.1
CLASSIFIER_API_PORT=8001
CLASSIFIER_API_PYTHON=python

# memory | postgres
STORE_PROVIDER=memory

# Use one of the following options:
# 1) DATABASE_URL
# 2) DB_HOST + DB_PORT + DB_NAME + DB_USER + DB_PASSWORD
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# disable | require
DB_SSL_MODE=require
