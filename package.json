{
  "name": "riwlogi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun --watch src/server.js",
    "start": "bun src/server.js",
    "test": "STORE_PROVIDER=memory bun test",
    "export:backend-seed": "bun scripts/export-backend-seed.mjs",
    "export:openapi": "bun scripts/export-openapi.mjs",
    "db:migrate": "STORE_PROVIDER=postgres bun scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.1",
    "axios": "1.13.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "kysely": "^0.28.11",
    "pg": "^8.18.0",
    "pino": "^9.9.5",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  }
}
